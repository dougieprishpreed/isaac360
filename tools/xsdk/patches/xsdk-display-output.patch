+static bool shows_output(const VIDEO_MODE *video)
+{
+	return !video->is_interlaced && video->is_widescreen && !letterbox_forced && video->display_width &&
+		video->display_height && video->display_width <= WIDTH_1080P && video->display_height <= HEIGHT_1080P &&
+		video->display_width % RESOLVE_COLUMN == 0;
+}
+
+void xsdk_display_mode_size(XsdkDisplayMode mode, uint32_t *width, uint32_t *height)
+{
+	VIDEO_MODE video;
+	VdQueryVideoMode(&video);
+	const bool output = mode == XSDK_DISPLAY_OUTPUT && shows_output(&video);
+	*width = output ? video.display_width : WIDTH_720P;
+	*height = output ? video.display_height : HEIGHT_720P;
+}
+
+// Plans the mode's front buffer filling the output: 1280x720, or the output's own size 1:1.
+static bool plan_scaler(XsdkDisplayMode mode)
