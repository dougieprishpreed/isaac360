 }
 
+bool xsdk_display_take_output(uint32_t *width, uint32_t *height)
+{
+	assert(is_open);
+	VIDEO_MODE video;
+	VdQueryVideoMode(&video);
+	if (!scaling || !shows_output(&video) || (video.display_width == mode_width && video.display_height == mode_height))
+		return false;
+	mode_width = video.display_width;
+	mode_height = video.display_height;
+	plan_values(mode_width, mode_height, new_scaler);
+	xsdk_log_write("display: %ux%u shown 1:1 on the output from the first frame", (unsigned)mode_width,
+		(unsigned)mode_height);
+	*width = mode_width;
+	*height = mode_height;
+	return true;
