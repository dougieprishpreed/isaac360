+		new_scaler[SCALER_ENABLE] ? "scaled" : "shown 1:1", (unsigned)video.display_width,
+		(unsigned)video.display_height);
 	if (letterboxed)
 		xsdk_log_write("display: xsdk_present letterboxes its frames, as %s",
